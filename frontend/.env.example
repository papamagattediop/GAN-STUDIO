# ──────────────────────────────────────────────────────────────
# GAN Studio — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ──────────────────────────────────────────────────────────────

# ── Phase test : proxy Railway (HF Spaces) ─────────────────
# Remplacer par l'URL de votre service Railway après déploiement
VITE_PROGAN_URL=https://VOTRE_SERVICE.railway.app/progan
VITE_STYLEGAN_URL=https://VOTRE_SERVICE.railway.app/stylegan
VITE_DCGAN_URL=https://VOTRE_SERVICE.railway.app/dcgan
VITE_T2I_URL=https://VOTRE_SERVICE.railway.app

# ── Phase production : APIs RunPod ─────────────────────────
# Décommenter quand les vrais modèles sont prêts
# VITE_PROGAN_URL=https://VOTRE_POD_ID-5002.proxy.runpod.net
# VITE_STYLEGAN_URL=https://VOTRE_POD_ID-5001.proxy.runpod.net
# VITE_DCGAN_URL=https://VOTRE_POD_ID-5003.proxy.runpod.net
# VITE_T2I_URL=https://VOTRE_SERVICE.railway.app

# ── Développement local : proxy local ──────────────────────
# Décommenter pour tester avec "python proxy.py" en local
# VITE_PROGAN_URL=http://localhost:8000/progan
# VITE_STYLEGAN_URL=http://localhost:8000/stylegan
# VITE_DCGAN_URL=http://localhost:8000/dcgan
# VITE_T2I_URL=http://localhost:8000
